# Copy to .env on the server. Never commit credentials.
PORT=8000
HOST=127.0.0.1
# Persistent directory. Back up this directory; it contains the SQLite database.
DATA_DIR=./data
# Generate a long, random access code and share it only with authorized staff.
METER_ACCESS_CODE=
# Optional for a separate frontend; exact origin without trailing slash.
# ALLOWED_ORIGIN=https://uhlenkoeper.github.io
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address authorized by your mail provider.
SMTP_FROM=
# Recipient is fixed in server code: info@uhlenkoeper-camp.de
